---
import Layout from '../layouts/Layout.astro';
import { baseUrl } from '../lib/baseUrl';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${baseUrl('agenda')}`} />
    <link rel="canonical" href={baseUrl('agenda')} />
    <title>Redirigiendo a Agenda...</title>
    <script is:inline define:vars={{ targetUrl: baseUrl('agenda') }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <body class="bg-[#0a0a0a] text-white flex items-center justify-center min-h-screen font-mono text-xs">
    <div class="text-center space-y-4">
      <p class="text-accent animate-pulse">Redirigiendo a /agenda...</p>
    </div>
  </body>
</html>
